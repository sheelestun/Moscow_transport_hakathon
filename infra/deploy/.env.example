# Copy to .env (same folder) and fill in. Relative paths are relative to this folder.

# Postgres (not published outside the compose network)
POSTGRES_USER=mowtransit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mowtransit

# The organizers' dataset, unpacked (contains validate/traffic.csv, validate/schedule_plan.csv, ...)
DATASET_DIR=../../dataset
# ML artifacts from the ML team (catboost_meta.json, catboost_seed*.cbm, catboost_quantiles.cbm, ...)
ML_ARTIFACTS_DIR=../../ml/artifacts

# Browser origin allowed to call the API (JSON list)
CORS_ORIGINS=["https://app.mowtransit.ru"]
# What the dashboard calls from the browser
PUBLIC_API_BASE=https://api.mowtransit.ru
PUBLIC_WS_URL=wss://api.mowtransit.ru/ws

# Dataset clock: empty = current Moscow time of day on 2026-01-06. The dataset is one day; at night the
# city is empty and after midnight MSK there is no data — pin it for a demo, e.g. 2026-01-06T08:00:00
CLOCK_START=
CLOCK_SPEED=1
